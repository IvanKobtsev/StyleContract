{
  "name": "style-contract",
  "version": "0.6.0",
  "description": "Static contract checker for CSS Modules and TypeScript",
  "license": "MIT",
  "author": "Ivan Kobtsev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanKobtsev/StyleContract.git"
  },
  "homepage": "https://github.com/IvanKobtsev/StyleContract#readme",
  "bugs": {
    "url": "https://github.com/IvanKobtsev/StyleContract/issues"
  },
  "keywords": [
    "css",
    "scss",
    "css-modules",
    "typescript",
    "lint",
    "cli",
    "rust"
  ],
  "bin": {
    "style-contract": "npm/style-contract.js"
  },
  "files": [
    "npm/style-contract.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cargo build --release --locked",
    "test": "cargo test --locked",
    "lint": "cargo fmt --check && cargo clippy --all-targets --all-features -- -D warnings",
    "prepack": "node npm/verify-release.js"
  },
  "optionalDependencies": {
    "@style-contract/binary-darwin-arm64": "0.6.0",
    "@style-contract/binary-darwin-x64": "0.6.0",
    "@style-contract/binary-linux-arm64-gnu": "0.6.0",
    "@style-contract/binary-linux-arm64-musl": "0.6.0",
    "@style-contract/binary-linux-x64-gnu": "0.6.0",
    "@style-contract/binary-linux-x64-musl": "0.6.0",
    "@style-contract/binary-win32-arm64": "0.6.0",
    "@style-contract/binary-win32-x64": "0.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
